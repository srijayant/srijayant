{
  // Config for markdownlint-cli2. GitHub profile READMEs favor readable prose
  // over hard line-length limits and permit the occasional inline HTML/emoji.
  "config": {
    "default": true,
    "MD013": false, // line length: prose and tables can be long
    "MD033": false, // inline HTML is allowed on GitHub profiles
    "MD041": false  // first line need not be a top-level heading
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules"]
}
